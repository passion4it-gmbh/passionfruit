---
import BaseLayout from "~/layouts/BaseLayout.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import { useTranslations, type Locale } from "~/i18n";
import heroImage from "~/assets/home/hero.png";

// Static-output 404: locale is decided at build time, not request time.
// Cloudflare Pages walks up the directory tree for the nearest 404.html,
// so /en/missing serves src/pages/en/404.astro and /missing serves this one.
const lang: Locale = "de";
const { t } = useTranslations(lang);

const homeHref = "/";
const title = t("state.404.title");
const description = t("state.404.body");
---

<BaseLayout title={title} description={description} lang={lang} noindex={true}>
  <AsymmetricHero
    eyebrow="404"
    headline={title}
    lede={description}
    cta={{ label: t("state.404.cta"), href: homeHref }}
    image={heroImage}
    imageAlt=""
    imagePosition="right"
    tone="surface"
    padding="lg"
  />
</BaseLayout>
