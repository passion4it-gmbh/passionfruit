---
import BaseLayout from "~/layouts/BaseLayout.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import { useTranslations, type Locale } from "~/i18n";
import heroImage from "~/assets/home/hero.png";

// Locale detection mirrors the catch-all [...path].astro pattern.
// Cloudflare Pages serves this same 404 for both /missing and /en/missing.
const lang: Locale = Astro.url.pathname.startsWith("/en") ? "en" : "de";
const { t } = useTranslations(lang);

const homeHref = lang === "en" ? "/en/" : "/";
const title = t("state.404.title");
const description = t("state.404.body");
---

<BaseLayout title={title} description={description} lang={lang} noindex={true}>
  <AsymmetricHero
    eyebrow="404"
    headline={title}
    lede={description}
    cta={{ label: t("state.404.cta"), href: homeHref }}
    image={heroImage}
    imageAlt=""
    imagePosition="right"
    tone="surface"
    padding="lg"
  />
</BaseLayout>
