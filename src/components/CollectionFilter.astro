---
import { useTranslations, type Locale } from "~/i18n";

export interface FacetValue {
  /** URL-safe key used in query params, e.g. "ai" or "case-study" */
  key: string;
  /** User-visible label */
  label: string;
  /** Optional item count displayed next to the label */
  count?: number;
}

export interface Facet {
  /** Query param name, e.g. "category" or "tag" */
  key: string;
  /** User-visible group heading */
  label: string;
  /** Available values for this facet */
  values: FacetValue[];
}

interface Props {
  /** Taxonomy groups — each becomes a set of filter chips */
  facets: Facet[];
  /** Current active selections keyed by facet key, e.g. { tag: ["ai", "design"] } */
  selected: Record<string, string[]>;
  lang: Locale;
  /** Base URL to build filter links against — defaults to current path */
  baseUrl?: string;
  /** Override the "Reset filters" label; falls back to t('filter.reset') */
  resetLabel?: string;
  /** Extra classes on the root element */
  class?: string;
}

const {
  facets,
  selected,
  lang,
  baseUrl,
  resetLabel,
  class: className = "",
} = Astro.props;

const { t } = useTranslations(lang);

const resolvedResetLabel = resetLabel ?? t("filter.reset");
const allLabel = t("filter.allLabel");

/**
 * Build a URL for toggling a specific facet value.
 * If the value is already selected, clicking removes it (toggle off).
 * If not selected, it adds it alongside existing selections.
 */
function buildToggleUrl(facetKey: string, valueKey: string): string {
  const params = new URLSearchParams();

  for (const [fk, values] of Object.entries(selected)) {
    const filtered =
      fk === facetKey
        ? values.includes(valueKey)
          ? values.filter((v) => v !== valueKey)
          : [...values, valueKey]
        : values;
    for (const v of filtered) {
      params.append(fk, v);
    }
  }

  // If this facet has no current selection, add the new value
  if (!(facetKey in selected)) {
    params.append(facetKey, valueKey);
  }

  const base = baseUrl ?? "";
  const qs = params.toString();
  return qs ? `${base}?${qs}` : base || "?";
}

/** URL that clears all filters — just the base path */
const resetUrl = baseUrl ?? "";

const hasActiveFilters = Object.values(selected).some((v) => v.length > 0);
---

<nav
  class:list={["collection-filter", className]}
  aria-label={t("filter.ariaLabel")}
>
  {
    facets.map((facet) => {
      const activeValues = selected[facet.key] ?? [];

      return (
        <div class="flex flex-wrap items-center gap-2 mb-3 last:mb-0">
          <span class="text-xs font-semibold uppercase tracking-wide text-muted mr-1 shrink-0">
            {facet.label}
          </span>

          {/* "All" chip — links to URL without this facet param */}
          {(() => {
            const params = new URLSearchParams();
            for (const [fk, values] of Object.entries(selected)) {
              if (fk !== facet.key) {
                for (const v of values) params.append(fk, v);
              }
            }
            const qs = params.toString();
            const href = qs ? `${baseUrl ?? ""}?${qs}` : (baseUrl ?? "");
            const isAll = activeValues.length === 0;
            return (
              <a
                href={href || "?"}
                aria-current={isAll ? "true" : undefined}
                class:list={["chip", isAll ? "chip--active" : "chip--idle"]}
              >
                {allLabel}
              </a>
            );
          })()}

          {facet.values.map((val) => {
            const isActive = activeValues.includes(val.key);
            return (
              <a
                href={buildToggleUrl(facet.key, val.key)}
                aria-current={isActive ? "true" : undefined}
                class:list={["chip", isActive ? "chip--active" : "chip--idle"]}
              >
                {val.label}
                {val.count !== undefined && (
                  <span class="ml-1 opacity-60 text-xs">({val.count})</span>
                )}
              </a>
            );
          })}
        </div>
      );
    })
  }

  {
    hasActiveFilters && (
      <div class="mt-2">
        <a
          href={resetUrl || "/"}
          class="inline-flex items-center gap-1.5 text-sm font-medium text-muted hover:text-accent transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent rounded"
          aria-label={resolvedResetLabel}
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 6h18" />
            <path d="M8 6V4h8v2" />
            <path d="M19 6l-1 14H6L5 6" />
          </svg>
          {resolvedResetLabel}
        </a>
      </div>
    )
  }
</nav>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
    /* 44px min touch target via line-height + padding */
    min-height: 2.75rem;
  }

  .chip--idle {
    color: var(--color-text);
    background-color: transparent;
  }

  .chip--idle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .chip--active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .chip--active:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  .chip:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
