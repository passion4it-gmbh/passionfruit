---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import Section from "~/components/Section.astro";
import Button from "~/components/Button.astro";
import type { AsymmetricHeroProps } from "~/types/sections";

type Props = AsymmetricHeroProps;

const {
  eyebrow,
  headline,
  lede,
  cta,
  secondaryCta,
  image,
  imageAlt = "",
  imagePosition = "right",
  tone = "surface",
  padding = "lg",
} = Astro.props;

const isFullbleed = image !== undefined && imagePosition === "fullbleed";
const layoutClass = !image
  ? "pf-hero--text-only"
  : isFullbleed
    ? "pf-hero--fullbleed"
    : imagePosition === "left"
      ? "pf-hero--image-left"
      : "pf-hero--image-right";

// On dark or fullbleed, buttons live on a dark surface.
const buttonTone = tone === "dark" || isFullbleed ? "on-dark" : "on-light";
---

<Section
  tone={tone}
  padding={padding}
  class={tone === "dark" ? "pf-hero-glow" : undefined}
>
  <div class:list={["pf-hero", layoutClass]}>
    <div class="pf-hero__text">
      <div class="pf-hero__head hero-stagger" style="--delay: 100ms">
        {eyebrow && <span class="text-eyebrow pf-hero__eyebrow"
          >{eyebrow}</span
        >}
        <h1 class="text-display pf-hero__headline">
          <slot name="headline">{headline}</slot>
        </h1>
      </div>

      {(lede || cta) && <div
        class="pf-hero__body hero-stagger"
        style="--delay: 250ms"
      >
        {lede && <p class="text-body-lg pf-hero__lede">{lede}</p>}
        {cta && <div class="pf-hero__cta">
          <Button
            href={cta.href}
            variant="primary"
            tone={buttonTone}
            class="btn-glow group"
          >
            {cta.label}
            <ArrowRight
              class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </Button>
          {secondaryCta && <Button
            href={secondaryCta.href}
            variant="secondary"
            tone={buttonTone}
          >
            {secondaryCta.label}
          </Button>}
        </div>}
      </div>}
    </div>

    {image && <div class="pf-hero__media hero-stagger" style="--delay: 400ms">
      <Image
        src={image}
        alt={imageAlt}
        widths={[480, 720, 960, 1280]}
        sizes={isFullbleed ? "100vw" : "(min-width: 768px) 42vw, 100vw"}
        loading="eager"
        class="pf-hero__image"
      />
    </div>}
  </div>
</Section>

<style>
  /* Dark tone: two soft light pools (accent top-left, warm bottom-right)
     give the surface depth without blurred DOM blobs. */
  :global(.pf-hero-glow) {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  :global(.pf-hero-glow)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Fade out before the bottom edge so a following dark section (careers)
       doesn't show a hard seam. */
    mask-image: linear-gradient(to bottom, black 50%, transparent);
    background:
      radial-gradient(
        48rem 32rem at 0% 20%,
        color-mix(in srgb, var(--color-accent) 24%, transparent),
        transparent 70%
      ),
      radial-gradient(
        40rem 28rem at 100% 100%,
        color-mix(in srgb, var(--color-warm) 12%, transparent),
        transparent 70%
      );
  }

  .pf-hero {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  .pf-hero__eyebrow {
    display: inline-block;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }

  /* Long single words (de: "Veranstaltungen") must break rather than clip
     at display size; html[lang] drives the hyphenation dictionary. */
  .pf-hero__headline {
    margin: 0;
    text-wrap: balance;
    hyphens: auto;
    overflow-wrap: break-word;
  }

  .pf-hero__body {
    margin-top: var(--space-6);
  }

  .pf-hero__lede {
    margin: 0;
    max-width: 40rem;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .pf-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .pf-hero__image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  @media (min-width: 768px) {
    .pf-hero {
      grid-template-columns: var(--grid-cols-12);
      gap: var(--grid-gap-lg);
      align-items: center;
    }

    .pf-hero--image-right .pf-hero__text {
      grid-column: 1 / span 7;
    }
    .pf-hero--image-right .pf-hero__media {
      grid-column: 8 / span 5;
      margin-block-start: 2rem;
    }

    .pf-hero--image-left .pf-hero__media {
      grid-column: 1 / span 5;
      grid-row: 1;
      margin-block-start: 2rem;
    }
    .pf-hero--image-left .pf-hero__text {
      grid-column: 6 / span 7;
      grid-row: 1;
    }

    .pf-hero--text-only .pf-hero__text {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    /* Text only: headline left, lede + CTAs right, sharing a baseline at the
       bottom. Uses the width a missing image would otherwise leave empty. */
    .pf-hero--text-only .pf-hero__text {
      display: grid;
      grid-template-columns: var(--grid-cols-12);
      gap: var(--grid-gap-lg);
      align-items: last baseline;
    }
    .pf-hero--text-only .pf-hero__head {
      grid-column: 1 / span 7;
    }
    .pf-hero--text-only .pf-hero__body {
      grid-column: 8 / span 5;
      margin-top: 0;
    }
  }

  /* Fullbleed variant — image fills the section, text overlays with a
     gradient backdrop. Section's inner container constrains the text column
     while the image escapes via absolute positioning. */
  .pf-hero--fullbleed {
    position: relative;
    isolation: isolate;
    min-height: clamp(20rem, 50vw, 32rem);
  }

  .pf-hero--fullbleed .pf-hero__media {
    position: absolute;
    inset: calc(var(--space-section-lg) * -1) calc(var(--space-section-lg) * -1);
    z-index: -2;
    border-radius: 0;
  }

  .pf-hero--fullbleed .pf-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .pf-hero--fullbleed::before {
    content: "";
    position: absolute;
    inset: calc(var(--space-section-lg) * -1) calc(var(--space-section-lg) * -1);
    background: linear-gradient(
      to right,
      var(--color-overlay-scrim-strong),
      var(--color-overlay-scrim-mid) 60%,
      var(--color-overlay-scrim-clear) 100%
    );
    z-index: -1;
    pointer-events: none;
  }

  .pf-hero--fullbleed .pf-hero__text {
    color: var(--color-text-on-dark);
    max-width: 40rem;
    padding-block: var(--space-12);
  }

  /* On the dark scrim, the default accent (--color-accent) reads as low-contrast
     indigo-on-dark; the brighter --color-accent-glow keeps the eyebrow legible. */
  .pf-hero--fullbleed .pf-hero__eyebrow {
    color: var(--color-accent-glow);
  }

  .pf-hero--fullbleed .pf-hero__lede {
    color: inherit;
  }

  @media (min-width: 768px) {
    .pf-hero--fullbleed .pf-hero__text {
      grid-column: 2 / span 6;
      grid-row: 1;
    }
    .pf-hero--fullbleed .pf-hero__media {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
</style>
