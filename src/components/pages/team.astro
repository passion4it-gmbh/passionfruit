---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Motion from "~/components/motion/Motion.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import TeamCard from "~/components/TeamCard.astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const allMembers = await getCollection("team");
const members = allMembers
  .filter((m) => m.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);
---

<BaseLayout
  title={t("team.title")}
  description={t("team.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    headline={t("team.title")}
    lede={t("team.description")}
  />

  <!-- Team grid -->
  <section class="py-20 md:py-28">
    <div class="container">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {members.map((member, i) => <Motion delay={(i % 3) * 100}>
          <TeamCard entry={member} lang={lang} />
        </Motion>)}
      </div>
    </div>
  </section>
</BaseLayout>
