---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Motion from "~/components/motion/Motion.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import BlogCard from "~/components/BlogCard.astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title={t("blog.title")}
  description={t("blog.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    headline={t("blog.title")}
    lede={t("blog.description")}
  />

  <!-- Posts -->
  <section class="py-20 md:py-28">
    <div class="container">
      {posts.length === 0 ? (
        <p class="text-muted text-center py-16">{t("blog.noPosts")}</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, i) => <Motion delay={(i % 3) * 100}>
            <BlogCard entry={post} lang={lang} />
          </Motion>)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
