---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Motion from "~/components/motion/Motion.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import EventCard from "~/components/EventCard.astro";
import EventsFilter from "~/components/EventsFilter.astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const selectedCategories = Astro.url.searchParams.getAll("category");
const selectedTags = Astro.url.searchParams.getAll("tag");

const selected: Record<string, string[]> = {
  category: selectedCategories,
  tag: selectedTags,
};

const allEvents = await getCollection("events", ({ id }) =>
  id.startsWith(`${lang}/`),
);

const filteredEvents = allEvents
  .filter((event) => {
    const categoryMatch =
      selectedCategories.length === 0 ||
      selectedCategories.includes(event.data.category);
    const tagMatch =
      selectedTags.length === 0 ||
      event.data.tags.some((tag) => selectedTags.includes(tag));
    return categoryMatch && tagMatch;
  })
  .sort((a, b) => a.data.startsAt.getTime() - b.data.startsAt.getTime());
---

<BaseLayout
  title={t("events.title")}
  description={t("events.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    headline={t("events.title")}
    lede={t("events.description")}
  />

  <!-- Filter + Events grid -->
  <section class="py-20 md:py-28">
    <div class="container">
      <EventsFilter
        entries={allEvents}
        {lang}
        {selected}
        baseUrl={Astro.url.pathname}
      />

      {filteredEvents.length === 0 ? (
        <p class="text-muted text-center py-16">{t("events.noResults")}</p>
      ) : (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {filteredEvents.map((event, i) => <Motion delay={(i % 3) * 100}>
            <EventCard entry={event} lang={lang} />
          </Motion>)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
