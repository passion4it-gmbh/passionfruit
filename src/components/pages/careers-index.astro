---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Motion from "~/components/motion/Motion.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import CareerCard from "~/components/CareerCard.astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const allJobs = await getCollection("careers");
const jobs = allJobs
  .filter((j) => j.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.postedAt.getTime() - a.data.postedAt.getTime());
---

<BaseLayout
  title={t("careers.title")}
  description={t("careers.description")}
  lang={lang}
  currentSlug={currentSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    headline={t("careers.title")}
    lede={t("careers.description")}
  />

  <!-- Job listings -->
  <section class="py-20 md:py-28 bg-surface-dark">
    <div class="container">
      {jobs.length === 0 ? (
        <p class="text-text-on-dark/50 text-center py-16">
          {t("careers.noOpenings")}
        </p>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {jobs.map((job, i) => <Motion delay={(i % 3) * 100}>
            <CareerCard entry={job} lang={lang} />
          </Motion>)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
