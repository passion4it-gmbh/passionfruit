---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import FeatureList from "~/components/sections/FeatureList.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import { getAlternateCollectionSlug, pageHref } from "~/lib/page-registry";
import { getServices } from "~/data/services";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const alternateSlug = await getAlternateCollectionSlug(
  lang,
  "pages",
  "services",
);

const pagesEntries = await getCollection("pages");
const heroImage = pagesEntries.find(
  (p) => p.id.startsWith(`${lang}/`) && p.data.translationKey === "services",
)?.data.heroImage;
---

<BaseLayout
  title={t("services.title")}
  description={t("services.description")}
  lang={lang}
  currentSlug={currentSlug}
  alternateSlug={alternateSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    headline={t("services.title")}
    lede={t("services.description")}
    image={heroImage}
  />

  <FeatureList headline={t("home.features.title")} items={getServices(lang)} />

  <CtaBand
    headline={t("home.ctaSection.title")}
    lede={t("home.ctaSection.subtitle")}
    cta={{ label: t("cta.contact"), href: pageHref("contact", lang) }}
  />
</BaseLayout>
