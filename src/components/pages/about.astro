---
import { getCollection } from "astro:content";
import { stats } from "~/data/stats";
import type { Locale } from "~/i18n";
import { useTranslations } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import Section from "~/components/Section.astro";
import Button from "~/components/Button.astro";
import Motion from "~/components/motion/Motion.astro";
import TeamCard from "~/components/TeamCard.astro";
import AsymmetricHero from "~/components/sections/AsymmetricHero.astro";
import CtaBand from "~/components/sections/CtaBand.astro";
import { getAlternateCollectionSlug, pageHref } from "~/lib/page-registry";
import { ArrowRight, Shield, Eye, Zap, Heart } from "@lucide/astro";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;
const { t } = useTranslations(lang);

const alternateSlug = await getAlternateCollectionSlug(lang, "pages", "about");

const allMembers = await getCollection("team");
const members = allMembers
  .filter((m) => m.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

const pagesEntries = await getCollection("pages");
const heroImage = pagesEntries.find(
  (p) => p.id.startsWith(`${lang}/`) && p.data.translationKey === "about",
)?.data.heroImage;

const values = [
  { icon: Shield, key: "quality" },
  { icon: Eye, key: "transparency" },
  { icon: Zap, key: "innovation" },
  { icon: Heart, key: "accessibility" },
];
---

<BaseLayout
  title={t("about.title")}
  description={t("about.description")}
  lang={lang}
  currentSlug={currentSlug}
  alternateSlug={alternateSlug}
  headerVariant="on-dark"
>
  <AsymmetricHero
    tone="dark"
    eyebrow={t("about.story.eyebrow")}
    headline={t("about.story.title")}
    lede={t("about.story.text")}
    image={heroImage}
  />

  {stats.length > 0 && <div class="container relative z-10 -mt-14">
    <dl
      class="grid grid-cols-2 md:grid-cols-4 gap-y-8 rounded-2xl border border-border bg-surface-elevated px-6 py-8 shadow-xl shadow-accent/5 md:divide-x md:divide-border md:py-10 hero-stagger"
      style="--delay: 400ms"
    >
      {stats.map((stat) => <div class="flex flex-col-reverse text-center px-4">
        <dt class="text-body-sm font-medium text-muted mt-1">
          {t(stat.labelKey)}
        </dt>
        <dd class="text-h1 font-extrabold gradient-text">{stat.value}</dd>
      </div>)}
    </dl>
  </div>}

  <Section>
    <Motion>
      <p class="eyebrow">{t("about.values.eyebrow")}</p>
      <h2 class="text-h1 mt-3 max-w-2xl text-balance">
        {t("about.values.title")}
      </h2>
    </Motion>

    <div class="grid gap-x-12 sm:grid-cols-2 mt-12">
      {values.map((val, i) => <Motion delay={(i % 2) * 100}>
        <div class="flex gap-5 border-t border-border py-8">
          <div
            class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center flex-shrink-0"
          >
            <val.icon class="w-6 h-6 text-accent" aria-hidden="true" />
          </div>
          <div>
            <h3 class="text-h3">{t(`about.values.${val.key}.title`)}</h3>
            <p class="text-muted mt-2 leading-relaxed">
              {t(`about.values.${val.key}.description`)}
            </p>
          </div>
        </div>
      </Motion>)}
    </div>
  </Section>

  {members.length > 0 && <Section tone="elevated">
    <Motion>
      <header class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div>
          <p class="eyebrow">{t("team.title")}</p>
          <h2 class="text-h1 mt-3">{t("team.description")}</h2>
        </div>
        <Button href={pageHref("team", lang)} variant="ghost" class="group">
          {t("navigation.team")}
          <ArrowRight
            class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
            aria-hidden="true"
          />
        </Button>
      </header>
    </Motion>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {members.map((member, i) => <Motion delay={(i % 3) * 100}>
        <TeamCard entry={member} lang={lang} />
      </Motion>)}
    </div>
  </Section>}

  <CtaBand
    headline={t("home.ctaSection.title")}
    lede={t("home.ctaSection.subtitle")}
    cta={{ label: t("cta.contact"), href: pageHref("contact", lang) }}
  />
</BaseLayout>
