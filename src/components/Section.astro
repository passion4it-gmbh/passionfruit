---
/**
 * Section — design-floor frame primitive.
 *
 * Wraps every page section with consistent tone (background + text color),
 * vertical padding from the section spacing tokens, and a max-width container.
 * Archetype components (AsymmetricHero, MagazineGrid, StickyStory, ...) compose
 * with this; pages compose with archetypes.
 */
type Tone = "surface" | "elevated" | "dark" | "accent-wash";
type Padding = "sm" | "md" | "lg";
type Container = "narrow" | "default" | "wide" | "full";
type AsTag = "section" | "article" | "aside" | "div";

interface Props {
  tone?: Tone;
  padding?: Padding;
  container?: Container;
  as?: AsTag;
  class?: string;
}

const {
  tone = "surface" as const,
  padding = "md" as const,
  container = "default" as const,
  as: Tag = "section",
  class: className,
} = Astro.props;

// "default" is the site-wide .container (same edge as header and footer);
// the others only change its max-width.
const maxWidthByContainer: Record<Container, string | undefined> = {
  narrow: "48rem",
  default: undefined,
  wide: "88rem",
  full: "none",
};

const containerKey: Container = container;
const paddingVar = `var(--space-section-${padding})`;
const maxWidth = maxWidthByContainer[containerKey];

// Tone styles are emitted via the data-tone attribute so the cascade keeps
// hex literals out of components. accent-wash uses color-mix to derive a
// subtle accent tint from the @theme palette.
---

<Tag
  data-tone={tone}
  class:list={["pf-section", className]}
  style={`--pf-section-pad: ${paddingVar};`}
>
  <div
    class="container pf-section__inner"
    style={maxWidth && `max-width: ${maxWidth};`}
  >
    <slot />
  </div>
</Tag>

<style>
  .pf-section {
    padding-block: var(--pf-section-pad);
  }

  .pf-section[data-tone="surface"] {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .pf-section[data-tone="elevated"] {
    background-color: var(--color-surface-elevated);
    color: var(--color-text);
  }

  /* Remap the semantic text/border tokens so everything inside a dark
     section (headings from typography.css, archetype ledes, hairlines,
     Tailwind text-* utilities) reads correctly without per-component
     overrides. Light cards placed inside a dark section inherit these too —
     keep card grids on light tones. */
  .pf-section[data-tone="dark"] {
    --color-text: color-mix(
      in srgb,
      var(--color-text-on-dark) 85%,
      transparent
    );
    --color-text-heading: var(--color-text-on-dark);
    --color-muted: color-mix(
      in srgb,
      var(--color-text-on-dark) 65%,
      transparent
    );
    --color-border: color-mix(
      in srgb,
      var(--color-text-on-dark) 12%,
      transparent
    );
    background-color: var(--color-surface-dark);
    color: var(--color-text);
  }

  /* --color-accent is tuned for white backgrounds, too dark for text here */
  .pf-section[data-tone="dark"] :global(.text-eyebrow) {
    color: var(--color-accent-glow);
  }

  .pf-section[data-tone="accent-wash"] {
    background-color: color-mix(
      in srgb,
      var(--color-accent) 8%,
      var(--color-surface)
    );
    color: var(--color-text);
  }
</style>
