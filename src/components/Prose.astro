---
interface Props {
  dropCap?: boolean;
  measure?: "tight" | "default" | "wide";
}

const { dropCap = false, measure = "default" } = Astro.props;
---

<div
  class:list={["prose-root", `measure-${measure}`, { "has-drop-cap": dropCap }]}
>
  <slot />
</div>

<style>
  .prose-root {
    hanging-punctuation: first;
    max-inline-size: 70ch;
  }

  .measure-tight {
    max-inline-size: 60ch;
  }

  .measure-default {
    max-inline-size: 70ch;
  }

  .measure-wide {
    max-inline-size: 80ch;
  }

  @media (max-width: 640px) {
    .prose-root {
      max-inline-size: 100%;
    }
  }

  .has-drop-cap > p:first-of-type::first-letter {
    font-size: var(--text-display);
    float: inline-start;
    line-height: 0.85;
    margin-inline-end: 0.1em;
    padding-block-start: 0.05em;
    color: var(--color-text-heading);
    font-weight: 700;
  }
</style>
